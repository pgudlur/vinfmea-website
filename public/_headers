# HTML pages — always revalidate with server
/
  Cache-Control: no-cache

/login
  Cache-Control: no-cache

/pricing
  Cache-Control: no-cache

/app
  Cache-Control: no-cache

/app/*
  Cache-Control: no-cache

# Next.js hashed static assets — cache forever (immutable content hashes)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
